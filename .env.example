# Copy to .env and fill in for your environment. Nothing here is hardcoded
# in code — this file (or real env vars) is the only source of truth.

# felt-llm (llama.cpp, OpenAI-compatible) - the only model backend. When it
# is unreachable the model endpoints answer 503 "felt-llm offline".
FELT_LOCAL_LLM_URL=http://felt-llm:8080
FELT_LOCAL_LLM_MODEL=felt
FELT_LOCAL_LLM_TIMEOUT_S=60
# felt-vision (Qwen3-VL-2B) describes screenshots; set, felt-llm reacts to the text instead of the image
# FELT_VISION_URL=http://felt-vision:8080
# FELT_VISION_TIMEOUT_S=60

# Minimum seconds between spoken screen-observation reactions (the
# deterministic frequency limit — the model never decides to stay
# silent, see brain.py's process_screen_context).
FELT_SCREEN_REACTION_COOLDOWN_S=90

# POST /v1/react/event (events.py): minimum seconds between any two of
# her unprompted remarks, and an optional JSON override of the per-event
# policy table (cooldown_s / dedupe_s / min_duration_s / emotion / bypass_min_gap),
# e.g. '{"music_new_track": {"cooldown_s": 600}}'.
FELT_EVENT_REACTION_MIN_GAP_S=30
FELT_EVENT_POLICIES=

# Optional: felt-voice (STT/TTS + Nitro5 GPU status). Leave unset and
# voice-chat / get_gpu_status simply aren't available.
FELT_VOICE_URL=
# WP-62 M2b: felt-core's Felt service identity dir (mounted read-only from the
# server's vault service dir) - with an https:// FELT_VOICE_URL she talks mTLS
# with it. Unset = no Felt certs.
FELT_IDENTITY_DIR=
# Felt machine identity (B5.4): honour X-Felt-Identity at all (only once Caddy
# strips client copies everywhere), revoked cert serials (Caddy's decimal
# X-Felt-Serial, JSON list), and "token" (FELT_API_TOKEN) or "identity" (no
# shared token: deny by default unless SSO-gated, exempt or a machine identity).
FELT_MACHINE_IDENTITY=false
FELT_MACHINE_DENY_SERIALS=[]
FELT_AUTH_MODE=token
# Origins allowed on SSO-gated state-changing routes (no CSRF token: a set,
# foreign Origin is refused) - the web app and felt-tray's cert-only host.
FELT_APP_ORIGIN=https://felt.clockmost.com
FELT_APP_DESKTOP_ORIGIN=https://felt-desktop.clockmost.com
# WP-62 M1: a FAKE value only the vault delivers - proves the vault -> Agent ->
# secrets_dir path. Never set it here.
FELT_VAULT_PROBE=
# WP-55: shared bearer token every API client must send (Authorization:
# Bearer <token>). Leave unset to keep the API open (the old LAN posture).
# A secret - lives in sops secrets.env on the server, never in git.
FELT_API_TOKEN=
# WP-58: the felt-responder's own token - opens only POST /v1/incidents/handoff
# and /v1/incidents/{id}/report. A secret (sops on the server).
FELT_RESPONDER_TOKEN=
# WP-54: sentence-chunk streaming of chat replies (first chunk = TTS'd
# before answering, the rest via GET /v1/reply/{id}/chunk/{n}).
FELT_REPLY_STREAMING=true
FELT_REPLY_STREAM_FIRST_CHUNK_CHARS=40

# Optional: felt-desktop-agent (KDE Connect battery/ring, phone find).
# Leave unset and those skills simply aren't available.
FELT_DESKTOP_AGENT_URL=

# Optional: HP ENVY 6000 printer_status (plain IPP, no API key needed).
# Leave unset to disable. Host only (an IP or hostname) — IPP has its own
# port/path convention, see printer_status/skill.py.
FELT_HP_PRINTER_HOST=

# Optional: board_status — read-only view of the work board (WP-37): the Beads
# issues file in Mario's workspace repo, read via Gitea as the restricted user
# felt-board (read:repository token, in sops on the server); unset = "board
# isn't connected".
FELT_BOARD_GITEA_URL=https://git.clockmost.com
FELT_BOARD_REPO=Benylin/workspace
FELT_BOARD_PATH=.beads/issues.jsonl
FELT_BOARD_TOKEN=

# Home location, for location-dependent skills (weather, etc.). Unset by
# default — must be set per-deployment, never hardcoded.
FELT_HOME_LATITUDE=
FELT_HOME_LONGITUDE=

# Optional: news_digest — comma-separated RSS/Atom feed URLs. Empty by
# default; no default news source is assumed.
FELT_NEWS_FEEDS=

# Optional: ntfy subscribe side (read an existing alert topic — the
# ntfy_listener background task simply doesn't run if unset).
FELT_NTFY_URL=
FELT_NTFY_TOPIC=
FELT_NTFY_USER=
FELT_NTFY_PASSWORD=

# Optional: ntfy publish side — a separate, write-only credential/topic
# by design (least-privilege: the credential that can push to Mario's
# phone isn't the same one that can only read the existing topic).
FELT_NTFY_PUBLISH_USER=
FELT_NTFY_PUBLISH_PASSWORD=
FELT_NTFY_PUBLISH_TOPIC=

# Optional: Zabbix, for the get_container_status skill (reuses existing
# monitoring rather than a separate health-check path). Leave unset to
# disable.
FELT_ZABBIX_URL=
FELT_ZABBIX_API_TOKEN=
FELT_ZABBIX_HOST=clockmost

# Optional: Home Assistant (reuses the same instance/token
# clockmost-console already talks to, not a new integration). Leave
# FELT_HA_URL unset to disable. FELT_HA_ENTITIES is a deliberate explicit
# comma-separated allowlist — not every HA entity is exposed to voice
# control sight-unseen.
FELT_HA_URL=
FELT_HA_TOKEN=
FELT_HA_ENTITIES=
# The calendars (all of HA's are read): where new events and reminders go.
FELT_HA_CALENDAR_DEFAULT=calendar.lealmario47_gmail_com
FELT_HA_CALENDAR_REMINDERS=calendar.felt_reminders
# The shopping list's HA todo entity (shopping.py) - its own setting, not in
# FELT_HA_ENTITIES (those are devices to switch).
FELT_HA_SHOPPING_LIST=todo.shopping_list
# Felt's HA device, sent with each command to HA's own matcher (ha_assist.py),
# so "lights off" means the room she's in. Empty = no area.
FELT_HA_ASSIST_DEVICE=
# "dim the lights" with no number: this percent.
FELT_HA_DIM_PERCENT=30
# Mario's phone in HA's companion app (phone.py): notify.mobile_app_<phone>,
# sensor.<phone>_battery_level. Renamed when the app is re-registered.
FELT_PHONE=pocox7
# Home Assistant calling Felt (ha_auth.py, felt-ha-hub D3): Authentik's
# `ha-felt` OAuth provider - issuer URL (ends in /), JWKS (default
# <issuer>jwks/), client id, the service account. Empty issuer = route closed.
FELT_HA_AGENT_ISSUER=
FELT_HA_AGENT_JWKS_URL=
FELT_HA_AGENT_CLIENT_ID=
FELT_HA_AGENT_USERNAME=ha-felt

# Optional: generate_image (ComfyUI on the Nitro5). Leave FELT_COMFYUI_URL
# unset and the skill just reports itself unavailable. Point it at the
# Nitro5's raw LAN address, NOT comfy.clockmost.com (that's Authentik-
# gated for browser use, not for this backend-to-backend call).
FELT_COMFYUI_URL=
FELT_COMFYUI_DISPLAY_URL=https://comfy.clockmost.com

# Optional: proactive email awareness (IMAP). Leave FELT_IMAP_HOST unset
# and the watcher simply doesn't start. Use an app password, not your
# real account password, if your provider supports one (Gmail, etc.).
FELT_IMAP_HOST=
FELT_IMAP_PORT=993
FELT_IMAP_USER=
FELT_IMAP_PASSWORD=
FELT_IMAP_MAILBOX=INBOX
FELT_IMAP_POLL_SECONDS=60

# Optional: personal document search (search_documents), backed by the
# sibling drive-rag container on the same `edge` network. Internal-only
# service, no Caddy route, no auth of its own — felt-core is the only caller.
FELT_DRIVE_RAG_URL=http://drive-rag:8000

# Optional: play_music. Leave FELT_SPOTIFY_REFRESH_TOKEN unset and the skill
# reports itself unconfigured. A dedicated OAuth app from
# developer.spotify.com/dashboard (user-modify-playback-state +
# user-read-playback-state scopes) — not a shared/borrowed credential.
FELT_SPOTIFY_CLIENT_ID=
FELT_SPOTIFY_CLIENT_SECRET=
FELT_SPOTIFY_REFRESH_TOKEN=

# WP-16: LRCLIB lyrics (public, keyless). Disk cache, one JSON file per
# track (misses cached too; rate limits/5xx are not). The User-Agent is
# what LRCLIB sees - put a contact address in it if you want one.
FELT_LYRICS_CACHE_DIR=./data/lyrics
FELT_LYRICS_USER_AGENT=felt-core/0.1 (personal assistant)

FELT_DB_PATH=./data/felt.db
FELT_POE_TRADE_CACHE_PATH=./data/poe_trade_cache.json
# poe2_wiki's search: poe2rag via Caddy's machine host with her Felt cert
# (https://poe2-api.clockmost.com/api/search), or the in-network URL.
FELT_POE2_SEARCH_URL=http://poe2rag:8000/api/search
# Semantic router (brain/router.py, cm-6b0), shadow mode - only records what it
# would have picked. The model is baked into the image; missing = router off.
FELT_ROUTER_ENABLED=true
FELT_ROUTER_MODEL=BAAI/bge-small-en-v1.5
FELT_ROUTER_MODEL_DIR=/app/models
FELT_ROUTER_BAR=0.78
FELT_PLUGINS_DIR=./plugins

FELT_HOST=0.0.0.0
FELT_PORT=8420

# WP-25: enables POST /v1/proactive/debug (insert a proactive item by hand
# for testing). Leave unset/0 in production - not a normal client path.
FELT_DEBUG=
